# Copy this file's values in — never commit real secrets to git.
#
# MONGODB_URI: get this from MongoDB Atlas (free tier):
#   1. Create a free cluster at https://www.mongodb.com/cloud/atlas/register
#   2. Database Access -> add a database user (username + password)
#   3. Network Access -> Add IP Address -> Allow Access from Anywhere (0.0.0.0/0)
#      (needed since your free host's IP isn't static)
#   4. Database -> Connect -> Drivers -> copy the connection string and swap
#      in your username/password and a database name, e.g.:
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/donutmarket?retryWrites=true&w=majority

# JWT_SECRET: any long random string, used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

PORT=3000
