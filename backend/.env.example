# Copy to backend/.env and fill in — never commit real secrets.
#
# Don't want to set any of this up? Run `npm run dev:memory` instead: it starts
# a throwaway MongoDB, seeds the exchange and needs none of these values.

# MONGODB_URI — MongoDB Atlas (free M0 tier is enough):
#   1. Create a cluster at https://www.mongodb.com/cloud/atlas/register
#   2. Database Access  -> add a database user (username + password)
#   3. Network Access   -> Allow Access From Anywhere (0.0.0.0/0), since a
#      free host's outbound IP isn't fixed
#   4. Database -> Connect -> Drivers -> copy the string, and put a database
#      name in the path (…mongodb.net/donutmarket?…)
#
# Atlas gives you a replica set, which is what lets a trade run inside a
# transaction. A standalone mongod works too, but the server will warn that a
# crash mid-order could leave it half-applied.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/donutmarket?retryWrites=true&w=majority

# JWT_SECRET — signs login tokens. Any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

PORT=3000

# Optional: credentials used by `npm run seed:reset` when it creates the first
# admin account. Defaults to admin@donut.market / donutdonut.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=something-better

# Optional: log every resting-order settlement pass. Useful when a limit or
# stop order isn't filling and you want to see what the matcher decided.
# DM_DEBUG_ORDERS=1
